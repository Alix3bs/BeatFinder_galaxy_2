BEATFINDER_STATE_DIR=.beatfinder_state
BEATFINDER_PYTHON_BIN=/Users/traytray/.cache/codex-runtimes/codex-primary-runtime/dependencies/python/bin/python3
BEATFINDER_NODE_BIN=/Users/traytray/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node
PORT=8787
BEATFINDER_SUPABASE_MODE=local

# Optional Hugging Face text embedding integration.
HF_API_TOKEN=
BEATFINDER_HF_TEXT_ENDPOINT=
BEATFINDER_HF_TEXT_MODEL=sentence-transformers/all-MiniLM-L6-v2
BEATFINDER_TEXT_EMBEDDING_DIM=384

# Preferred Gemma integration knobs for future remote model hookup.
BEATFINDER_GEMMA_PROVIDER=local-fallback
BEATFINDER_GEMMA_MODEL=gemma-3
BEATFINDER_GEMMA_ENDPOINT=
BEATFINDER_GEMMA_API_TOKEN=
BEATFINDER_GEMMA_ALLOW_FALLBACK=true

# Optional Supabase runtime configuration.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
