# TopNotchRentalz server configuration
# Copy to .env — the real .env is gitignored and must never be committed.

# ---- server ----
PORT=8902
TN_BASE_URL=https://yourdomain.com
TN_MARKET=Miami
TN_SECURE_COOKIES=1            # set 1 when serving over HTTPS
TN_SESSION_IDLE_MINUTES=30     # auto-logout after inactivity
TN_SESSION_MAX_HOURS=8         # absolute session lifetime

# ---- first-run account passwords (optional) ----
# If unset, random temp passwords are generated and printed once to the
# server console, with a forced change on first login.
TN_ADMIN_PASSWORD=
TN_SALES_PASSWORD=
TN_OPS_PASSWORD=
TN_PARTNERSHIPS_PASSWORD=
TN_CX_PASSWORD=
TN_PARTNER1_PASSWORD=
TN_PARTNER2_PASSWORD=
TN_PARTNER3_PASSWORD=

# ---- Excel synchronization (server-side only; never sent to browsers) ----
# Power Automate "When an HTTP request is received" URL or Apps Script web app.
EXCEL_WEBHOOK_URL=
EXCEL_WEBHOOK_SECRET=

# ---- notifications (email-first) ----
# A flow/endpoint that sends the JSON payload as an email to the right team.
NOTIFY_EMAIL_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ---- storage ----
TN_DATA_DIR=                   # defaults to ./data (SQLite db + uploads)
