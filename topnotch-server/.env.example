# TopNotchRentalz server configuration
# Copy to .env — the real .env is gitignored and must never be committed.

# ---- server ----
PORT=8902
TN_BASE_URL=https://yourdomain.com
TN_MARKET=Miami
TN_SECURE_COOKIES=1            # set 1 when serving over HTTPS
TN_SESSION_IDLE_MINUTES=30     # auto-logout after inactivity
TN_SESSION_MAX_HOURS=8         # absolute session lifetime

# ---- first-run account passwords (optional) ----
# If unset, random temp passwords are generated and printed once to the
# server console, with a forced change on first login.
TN_ADMIN_PASSWORD=
TN_SALES_PASSWORD=
TN_OPS_PASSWORD=
TN_PARTNERSHIPS_PASSWORD=
TN_CX_PASSWORD=
TN_PARTNER1_PASSWORD=
TN_PARTNER2_PASSWORD=
TN_PARTNER3_PASSWORD=

# ---- Excel synchronization (server-side only; never sent to browsers) ----
# Power Automate "When an HTTP request is received" URL or Apps Script web app.
EXCEL_WEBHOOK_URL=
EXCEL_WEBHOOK_SECRET=

# ---- notifications (email-first) ----
# A flow/endpoint that sends the JSON payload as an email to the right team.
NOTIFY_EMAIL_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

# ---- storage ----
TN_DATA_DIR=                   # defaults to ./data (SQLite db + uploads)

# ---- environment ----
TN_ENV=staging                 # "staging" seeds demo data; "production" seeds ONLY real company data + the LUXX Miami onboarding lead

# ---- backups ----
BACKUP_ENCRYPTION_KEY=         # REQUIRED in production — AES-256-GCM key for daily backups
TN_BACKUP_DIR=                 # defaults to ./backups (put on the persistent disk)
TN_BACKUP_RETENTION=30

# ---- Stripe (test keys first, then live) ----
STRIPE_SECRET_KEY=             # sk_test_... — hosted Checkout only; card data never touches this server
STRIPE_WEBHOOK_SECRET=         # whsec_... — point the Stripe webhook at POST /api/stripe/webhook

# ---- email (pick one) ----
RESEND_API_KEY=                # after verifying topnotchrentalz.com in Resend
EMAIL_FROM=bookings@topnotchrentalz.com

# ---- Lumino (primary payment provider — adapter awaiting merchant docs) ----
LUMINO_API_BASE=               # e.g. https://api.lumino.example — from the merchant dashboard
LUMINO_API_KEY=                # secret API key — server-side only, never in the browser
LUMINO_WEBHOOK_SECRET=         # webhook signing secret; endpoint: POST /api/payments/webhook/lumino
LUMINO_AUTH_HEADER=            # default: Authorization
LUMINO_AUTH_PREFIX=            # default: "Bearer "
LUMINO_SIGNATURE_HEADER=       # default: x-lumino-signature (HMAC-SHA256 hex of raw body)
LUMINO_CHECKOUT_PATH=          # default: /v1/checkout-sessions
LUMINO_INVOICE_PATH=           # default: /v1/invoices
LUMINO_STATUS_PATH=            # default: /v1/payments/
LUMINO_REFUND_PATH=            # default: /v1/refunds
LUMINO_SUPPORTS_ACH=0          # set 1 only after Lumino confirms in writing
LUMINO_SUPPORTS_BNPL=0
LUMINO_SUPPORTS_AUTH_CAPTURE=0 # deposit authorization+capture — never simulated
MOCK_PAY_SECRET=               # staging mock-webhook signing secret (any random string)

# ---- Autopilot AI (Phase 5.2 — optional; everything critical is deterministic) ----
# The model is NEVER guessed. If OPENAI_MODEL or OPENAI_API_KEY is unset the
# Autopilot runs 100% deterministic workflows and simply skips LLM summaries.
# Set OPENAI_MODEL to the exact model id your account has access to
# (e.g. the newest available reasoning model, such as GPT-5.6 Sol IF your
# account lists it — verify in your provider dashboard first).
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_API_BASE=               # default: https://api.openai.com (any OpenAI-compatible endpoint)
# Cost caps are editable in Admin → Settings (ai_daily_cost_cap / ai_monthly_cost_cap).
# When a cap is hit the AI pauses itself; payments, booking safety and reminders continue.
