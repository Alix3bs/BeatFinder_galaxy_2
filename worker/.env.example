SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

SUPABASE_AUDIO_BUCKET=search-audio
SUPABASE_EMBED_QUERY_FUNCTION=embed_query
SUPABASE_FINGERPRINT_FUNCTION=fingerprint
SUPABASE_EMBED_BEAT_FUNCTION=embed

# Keep false if DB pgmq triggers already handle embedding on beats insert/update.
WORKER_ENABLE_DIRECT_EMBED_CALLS=false
WORKER_POLL_INTERVAL_MS=1200
WORKER_MATCH_LIMIT=20
WORKER_PERSIST_TOP_MATCHES=10
WORKER_EXACT_THRESHOLD=0.9
WORKER_CLOSE_THRESHOLD=0.6

# Set to "url" only if your beats table uses url instead of source_url.
BEATS_URL_COLUMN=source_url
